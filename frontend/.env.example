# Frontend environment variables
# Copy to .env.local

# Backend API URL (optional)
# Leave empty for the local Vite proxy or a same-origin production /api.
# Set only when the API is deliberately hosted on a separate HTTPS origin.
VITE_API_URL=

# Mapbox token for map visualization
# Get yours free at: https://account.mapbox.com/
VITE_MAPBOX_TOKEN=
