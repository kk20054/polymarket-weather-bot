LIVE_TRADING=false
LIVE_DRY_RUN=true
WEATHERBOT_SCHEDULER=false

# Optional local-only canary credentials. Never put these in VITE_* or Vercel.
# Installing the SDK or configuring a wallet does not enable trading.
POLY_PRIVATE_KEY=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLY_FUNDER=
POLY_SIGNATURE_TYPE=0

# Random secret shared only by the local API origin and the hosted Sites worker.
# Browser clients must never receive this value.
WEATHERBOT_ORIGIN_TOKEN=

# Optional weather providers
WEATHER_COM_API_KEY=
WUNDERGROUND_API_KEY=
VISUAL_CROSSING_KEY=

# Optional review and notifications
MINIMAX_API_KEY=
FEISHU_WEBHOOK_URL=
